{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:math-assessment:gold-label:v1",
  "title": "S9 independent document and item labels v1",
  "description": "One JSONL record. Field values preserve source raw text and pack locations. standards is an array of status-bearing groups, each with codes and values. Represent absent standards with one source_absent group and empty codes/values. title.role and method.options live on their field objects. free_semester is boolean. Numeric norm is optional. Activities are excluded in v1.",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/item"
    }
  ],
  "$defs": {
    "doc_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}(?:-c[0-9]{2,})?$"
    },
    "loc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "$ref": "#/$defs/doc_id"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "doc_id"
      ],
      "oneOf": [
        {
          "required": [
            "line"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "line_start"
                ]
              },
              {
                "required": [
                  "line_end"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "line_start",
            "line_end"
          ],
          "not": {
            "required": [
              "line"
            ]
          }
        }
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "loc"
      ],
      "properties": {
        "raw": {
          "type": "string"
        },
        "norm": {
          "type": "number"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "present",
            "source_absent",
            "ambiguous",
            "conflict"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "values"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_absent"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "semester",
        "line_start",
        "line_end"
      ],
      "properties": {
        "grade": {
          "enum": [
            1,
            2
          ]
        },
        "semester": {
          "enum": [
            1,
            2
          ]
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "present",
            "source_absent",
            "ambiguous",
            "conflict"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "note": {
          "type": "string"
        },
        "role": {
          "enum": [
            "평가영역",
            "과제명",
            "번호",
            "기타"
          ]
        }
      },
      "required": [
        "status",
        "values"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_absent"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "present",
            "source_absent",
            "ambiguous",
            "conflict"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "note": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "state"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "checked",
                  "unchecked",
                  "no_box",
                  "unreadable"
                ]
              },
              "mark": {
                "type": "string"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            }
          }
        },
        "other_text": {
          "type": "string"
        },
        "plain_text": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "values"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_absent"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "present",
            "source_absent",
            "ambiguous",
            "conflict"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "note": {
          "type": "string"
        },
        "codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\[9과\\d{2}-\\d{2}\\]$"
          }
        },
        "text": {
          "type": "string"
        },
        "area_name_raw": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "values",
        "codes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_absent"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "present",
            "source_absent",
            "ambiguous",
            "conflict"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "note": {
          "type": "string"
        },
        "link_basis": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "values"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_absent"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "doc_id",
        "school_id",
        "labeler",
        "edition",
        "edition_note",
        "science_sections",
        "notes"
      ],
      "properties": {
        "school_id": {
          "type": "string",
          "minLength": 1
        },
        "school_name": {
          "type": "string"
        },
        "labeler": {
          "enum": [
            "claude",
            "astra"
          ]
        },
        "type": {
          "const": "document"
        },
        "doc_id": {
          "$ref": "#/$defs/doc_id"
        },
        "edition": {
          "enum": [
            "valid",
            "superseded",
            "conflict"
          ]
        },
        "edition_note": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "science_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "school_id",
        "labeler",
        "grade",
        "semester",
        "item_key",
        "occurrences",
        "identity_basis",
        "free_semester",
        "title",
        "task_text",
        "task_no",
        "period",
        "method",
        "standards",
        "max_score",
        "sub_scores",
        "ratio",
        "rubric"
      ],
      "properties": {
        "school_id": {
          "type": "string",
          "minLength": 1
        },
        "school_name": {
          "type": "string"
        },
        "labeler": {
          "enum": [
            "claude",
            "astra"
          ]
        },
        "type": {
          "const": "item"
        },
        "grade": {
          "enum": [
            1,
            2
          ]
        },
        "semester": {
          "enum": [
            1,
            2
          ]
        },
        "item_key": {
          "type": "string",
          "pattern": "^.+-g[12]-s[12]-(?:0[1-9]|[1-9][0-9]+)$"
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loc"
          }
        },
        "identity_basis": {
          "type": "string",
          "minLength": 1
        },
        "free_semester": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "task_text": {
          "$ref": "#/$defs/field"
        },
        "task_no": {
          "$ref": "#/$defs/field"
        },
        "period": {
          "$ref": "#/$defs/field"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "standards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/standard"
          }
        },
        "max_score": {
          "$ref": "#/$defs/field"
        },
        "sub_scores": {
          "$ref": "#/$defs/field"
        },
        "ratio": {
          "$ref": "#/$defs/field"
        },
        "rubric": {
          "$ref": "#/$defs/rubric"
        }
      }
    }
  }
}
