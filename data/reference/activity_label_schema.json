{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:math-assessment:activity-label:v1",
  "title": "S9 2차 라벨: 정답 세트 항목의 활동 축 라벨 v1",
  "description": "JSONL 한 줄 = 항목 하나. definition_version은 docs/science_activity_definitions.md의 버전과 같아야 한다. primary는 활동 이름 10개 중 하나 또는 null(기권). secondary는 주활동을 뺀 보조활동 이름 배열(표 수 내림차순). evidence는 판정 근거 원문과 위치.",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_key", "definition_version", "primary", "secondary", "evidence"],
  "properties": {
    "item_key": {"type": "string", "pattern": "^ms-gold-[a-z]+-(city|gun)-g[12]-s[12]-[0-9]{2}$"},
    "definition_version": {"type": "string", "pattern": "^activity-def-v[0-9]+$"},
    "primary": {"anyOf": [{"$ref": "#/$defs/activity"}, {"type": "null"}]},
    "secondary": {"type": "array", "items": {"$ref": "#/$defs/activity"}, "uniqueItems": true},
    "abstain_reason": {"type": "string", "enum": ["근거 없음", "근거 동률", "체크 여러 개·요소 근거 없음", "체크 판독 불가"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "quote", "loc"],
        "properties": {
          "type": {"type": "string", "enum": ["checkbox", "method_text", "assessment_area", "rubric", "title_verb"]},
          "quote": {"type": "string", "minLength": 1},
          "activity": {"$ref": "#/$defs/activity"},
          "loc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["doc_id"],
            "properties": {
              "doc_id": {"type": "string", "pattern": "^[0-9a-f]{12}(?:-c[0-9]{2,})?$"},
              "line": {"type": "integer", "minimum": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "page": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "votes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "rule_applied": {"type": "string"},
    "note": {"type": "string"}
  },
  "$defs": {
    "activity": {"type": "string", "enum": ["탐구", "실험평가", "작성", "제작", "분석", "추론·설명", "발표·토론", "계산·측정", "과정평가", "문제해결"]}
  }
}
